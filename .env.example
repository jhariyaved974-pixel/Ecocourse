# Copy to .env.local for development. In production set these in the Vercel
# project settings. NEVER commit real values. Every value below is a placeholder.

# --- Public (shipped to the browser) ------------------------------------------
# Supabase project URL and publishable (anon) key — Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Legacy name, used only if the variable above is not set:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (no trailing slash). Used for emails, sitemap, OG tags and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------------
# Supabase secret / service-role key. Used ONLY on the server for checkout,
# payment proof storage, cron jobs and webhooks. Never expose it to the browser.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
# Legacy name, used only if SUPABASE_SECRET_KEY is not set:
# SUPABASE_SERVICE_ROLE_KEY=

# Random secret (>= 32 chars) used to derive guest order access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates existing guest order links (signed-in customers are unaffected).
ORDER_ACCESS_SECRET=replace-with-a-long-random-string

# Random secret (>= 16 chars). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-another-long-random-string

# Optional salt for hashing IP addresses in rate limits / proof submissions (defaults to ORDER_ACCESS_SECRET).
IP_HASH_SALT=

# --- Transactional email (optional until you are ready to send) ---------------
# Resend API key and a verified sender, e.g. "AUREN <orders@yourdomain.in>".
RESEND_API_KEY=
EMAIL_FROM=

# --- Razorpay (optional; online payments stay disabled until all three are set) -
# Use TEST mode keys first (Razorpay dashboard → Settings → API Keys / Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Development only ---------------------------------------------------------
# Lets next/image optimise images served from a local Supabase stack (127.0.0.1).
# ALLOW_LOCAL_IMAGE_OPTIMIZATION=1
