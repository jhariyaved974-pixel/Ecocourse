# ---------------------------------------------------------------------------------------------
# WeberAct client portal: environment variables
# Copy to .env.local for local development. On Vercel, add them under Project Settings,
# Environment Variables. NEVER commit real values. NEXT_PUBLIC_* values are visible in the
# browser by design; everything else stays on the server.
# ---------------------------------------------------------------------------------------------

# Supabase (Project Settings, API). The publishable key is safe in the browser: row level
# security decides what each signed-in person can read or change.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The portal's public address, used in invite and password links and in emails.
NEXT_PUBLIC_SITE_URL=https://portal.weberact.co

# Server only. The Supabase secret (service role) key. Optional, but needed to:
#   - send invite emails to new clients and team members from the admin panel
#   - record online payments from Razorpay or Stripe webhooks
#   - run the daily deadline and email jobs
SUPABASE_SECRET_KEY=

# Protects the scheduled jobs (/api/cron/*). Any long random string; Vercel Cron sends it.
CRON_SECRET=

# Email notifications through Resend (optional). Without them, in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM="WeberAct <portal@weberact.co>"

# Razorpay (INR payments, optional). Key ID is public; the secrets stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (international payments, optional).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google (optional). PageSpeed Insights works without a key at low volume; a key raises the limit.
PAGESPEED_API_KEY=
# Search Console and Analytics 4 through a service account added as a user on each property.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
